{
  "name": "solophp/image",
  "type": "library",
  "description": "Immutable GD images for PHP: EXIF orientation, bounded resizing, JPEG/PNG/WebP encoding and smaller-only optimization.",
  "keywords": [
    "php",
    "image",
    "gd",
    "webp",
    "resize",
    "exif"
  ],
  "homepage": "https://github.com/SoloPHP/Image",
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/SoloPHP/Image/issues",
    "source": "https://github.com/SoloPHP/Image"
  },
  "autoload": {
    "psr-4": {
      "Solo\\Image\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\Image\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-exif": "*",
    "ext-gd": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3.5",
    "phpunit/phpunit": "^12.5",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "cs": "phpcs",
    "cs-fix": "phpcbf",
    "check": [
      "@composer validate --strict",
      "@cs",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
